{
  "name": "fair-spin-android",
  "version": "1.3.2",
  "private": true,
  "description": "Fair Spin for Android",
  "author": "Jonathan Terrington",
  "scripts": {
    "sync": "cap sync android",
    "build:debug": "cap sync android && cd android && gradlew.bat assembleDebug",
    "build:release": "cap sync android && cd android && gradlew.bat assembleRelease bundleRelease"
  },
  "dependencies": {
    "@capacitor/android": "8.6.0",
    "@capacitor/app": "8.1.2",
    "@capacitor/core": "8.6.0",
    "@capacitor/haptics": "8.0.2",
    "@capacitor/splash-screen": "8.0.2"
  },
  "devDependencies": {
    "@capacitor/cli": "8.6.0"
  }
}
